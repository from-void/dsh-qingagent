{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@qingagent/contract-ts": ["./vendor/qingagent/packages/contract-ts/src/index.ts"],
      "@qingagent/contract-ts/*": ["./vendor/qingagent/packages/contract-ts/src/*"],
      "@qingagent/pm-schema": ["./vendor/qingagent/packages/pm-schema/src/index.ts"],
      "@qingagent/pm-schema/tiptap": ["./vendor/qingagent/packages/pm-schema/src/tiptap/createQingagentExtensions.ts"],
      "@qingagent/pm-schema/*": ["./vendor/qingagent/packages/pm-schema/src/*"],
      "@qingagent/diagram-engine": ["./vendor/qingagent/packages/diagram-engine/src/index.ts"],
      "@qingagent/diagram-engine/*": ["./vendor/qingagent/packages/diagram-engine/src/*"],
      "@qingweb/*": ["./vendor/qingagent/apps/web/src/*"],
      "@qingcore/*": ["./vendor/qingagent/packages/core/src/*"]
    }
  },
  "include": ["src", "tests"]
}
